#!/bin/sh /etc/rc.common

# Re-apply throughWall RAM e2p boost after WiFi is up.
# Does not write Factory NAND (read-only cal partition is expected).

START=99
STOP=10

start_service() {
	. /lib/functions.sh
	. /lib/viettel-nr3053-throughwall.sh

	viettel_throughwall_supported || return 0

	# Background: rax0 often appears after START=99.
	( viettel_throughwall_apply_with_retry 30 2 ) &
}

start() {
	start_service
}

stop() {
	return 0
}

reload() {
	start_service
}
