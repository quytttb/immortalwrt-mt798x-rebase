#!/bin/sh

# Apply when rax0 appears (net add) or when link state changes.
# Factory NAND is never written — iwpriv e2p is RAM-only.

case "$ACTION" in
add|register|up|change) ;;
*) exit 0 ;;
esac

[ "$INTERFACE" = "rax0" ] || [ "$DEVICENAME" = "rax0" ] || exit 0

. /lib/functions.sh
. /lib/viettel-nr3053-throughwall.sh

viettel_throughwall_supported || exit 0
viettel_throughwall_update

exit 0
