{
	"luci-app-viettel-storage": {
		"description": "Grant access to Viettel internal-storage controls",
		"read": {
			"file": {
				"/usr/sbin/viettel-storage status": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/usr/sbin/viettel-storage prepare-overlay": [ "exec" ],
				"/usr/sbin/viettel-storage prepare-storage": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		}
	}
}
