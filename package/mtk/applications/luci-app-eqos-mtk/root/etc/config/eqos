# EQoS global shaper — disabled by default.
# WARNING: 'download' and 'upload' are in Mbit/s (1–1000).
# The shipped default was 100/20 Mbit/s.  When enabled that cap applies to
# ALL WAN traffic through HNAT QDMA, producing ~96 Mbps on a 1 Gbps link.
# Set these to your actual WAN speed (or leave disabled) to avoid confusion.
config eqos 'config'
	option enabled      0
	option download     1000
	option upload       500

# Per-device bandwidth is kbit/s.
# Slots 1~31 use NETSYS V2/V3 64-QDMA HQoS.
# Slots 32 and above use tc software shaping with IPv4 or IPv6 selectors.
# qid0 is the default queue and qid63 is reserved for PPD.
# Configure exactly one of ip or ip6. LuCI may also save selector.
#config device
#	option enabled  1
#	option queue    1
#	option selector 'ip'
#	option ip       '192.168.1.100'
#	option download 10000
#	option upload   5000
